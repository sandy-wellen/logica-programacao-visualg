algoritmo "verificar_idade"
// Função :
// Autor :
// Data : 05/12/2025
// Seção de Declarações 
var
idade: inteiro

inicio
// Seção de Comandos 

   escreva("Digite a idade: ")
   leia(idade)

   se (idade >= 1) e (idade <= 100) entao
        escreval("Idade dentro da faixa permitida.")
   senao
        escreval("Idade fora da faixa permitida!")
fimse
fimalgoritmo
