algoritmo "semnome"
// Função :
// Autor :
// Data : 05/12/2025
// Seção de Declarações 
var
temperatura: real
inicio
// Seção de Comandos 
escreva("Digite a temperatura: ")
   leia(temperatura)

   se (temperatura > 0) entao
        escreval("A temperatura é positiva.")
   senao
        escreval("A temperatura NÃO é positiva.")
   fimse
fimalgoritmo
