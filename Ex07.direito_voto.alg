algoritmo "semnome"
// Função :
// Autor :
// Data : 05/12/2025
// Seção de Declarações 
var
idade: inteiro
inicio
// Seção de Comandos 
escreval ("Digite a sua idade")
leia (idade)

se (idade >= 16) entao
   escreval ("O cidadão esta apto a votar")
senao
     escreval ("O cidadao nao esta apto a votar")
fimse
fimalgoritmo
