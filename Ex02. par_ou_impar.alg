algoritmo "semnome"
// Função :
// Autor :
// Data : 05/12/2025
// Seção de Declarações 
var
numero: inteiro

inicio
// Seção de Comandos 
//Entrada
escreval ("Digite um numero")
leia (numero)

se (numero % 2 = 0) entao
   escreval ("O numero é PAR.")
senao
     escreval ("O numero é ÍMPAR.")
fimse
fimalgoritmo
