algoritmo "semnome"
// Função :
// Autor :
// Data : 29/11/2025
// Seção de Declarações 
var
reais: real
dolar: real

inicio
// Seção de Comandos 
//entradas
escreva ("digite o valor em reais")
leia (reais)

//processamento
dolar <- (reais / dolar)

//saida
escreva ("o valor em dolar é de:", dolar)
fimalgoritmo
